NODE_ENV=development
PORT=3000
# Optional: set a PostgreSQL connection string to enable persistent project/contact storage.
# Example: postgres://username:password@host:5432/database?sslmode=require
DATABASE_URL=
# Set true when the managed database requires TLS; verify your provider's instructions.
DATABASE_SSL=false
# Contact email shown on the portfolio. Replace with your real address.
CONTACT_EMAIL=your-email@example.com
# Optional real domain, without trailing slash. Used in sitemap.xml and canonical metadata.
SITE_URL=
# Optional: a long random value used only if you add protected admin functionality later.
